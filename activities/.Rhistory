read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/pg_murder_temps.csv")
muder_temps <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/pg_murder_temps.csv")
murder_temps <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/pg_murder_temps.csv")
View(murder_temps)
murder_temps |> summarize(correlation = cor(murders, temperature, method="pearson"))
consultants |>
ggplot() +
geom_point(aes(x=murders, y=temperature)) +
geom_smooth(aes(x=murders, y=temperature), method="lm") +
expand_limits(x = 0, y = 0)
murder_temps |>
ggplot() +
geom_point(aes(x=murders, y=temperature)) +
geom_smooth(aes(x=murders, y=temperature), method="lm") +
expand_limits(x = 0, y = 0)
murder_temps |>
ggplot() +
geom_text(aes(x=murders, y=temperature))
murder_temps |>
ggplot() +
geom_text(aes(label(x=murders, y=temperature))
murder_temps |>
ggplot() +
geom_text(aes(Label=(x=murders, y=temperature))
murder_temps |>
ggplot() +
geom_point(aes(x=murders, y=temperature)) +
geom_smooth(aes(x=murders, y=temperature), method="lm") +
expand_limits(x = 0, y = 0)+
geom_text(aes(x=murders, y=temperature))
View(murder_temps)
murder_temps |>
ggplot() +
geom_point(aes(x=murders, y=temperature)) +
geom_smooth(aes(x=murders, y=temperature), method="lm") +
expand_limits(x = 0, y = 0)+
geom_text(aes(x=murders, y=temperature, label = temperature))
murder_temps |>
ggplot() +
geom_point(aes(x=murders, y=temperature)) +
geom_smooth(aes(x=murders, y=temperature), method="lm") +
# expand_limits(x = 0, y = 0)+
geom_text(aes(x=murders, y=temperature, label = temperature))
